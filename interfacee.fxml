<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<TabPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="TimeMachineController">
    <tabs>
        <Tab text="Таймер">
            <content>
                <AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #F5F5F5">
                    <children>
                        <TextField fx:id="MinuteInput" layoutX="39.0" layoutY="86.0" prefHeight="30.0" prefWidth="70.0" promptText="Минуты" style="-fx-font-size: 14px; -fx-padding: 5px;" />
                        <TextField fx:id="SecondInput" layoutX="117.0" layoutY="86.0" prefHeight="30.0" prefWidth="70.0" promptText="Секунды" style="-fx-font-size: 14px; -fx-padding: 5px;" />
                        
                        <Button fx:id="startButton" layoutX="39.0" layoutY="132.0" mnemonicParsing="false" onAction="#startTimer" style="-fx-background-color: #5BBFBA; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10px; -fx-border-radius: 5px; -fx-background-radius: 5px;" text="Старт" />
                        <Button fx:id="stopButton" layoutX="101.0" layoutY="132.0" mnemonicParsing="false" onAction="#stopTimer" style="-fx-background-color: #E94E77; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10px; -fx-border-radius: 5px; -fx-background-radius: 5px;" text="Стоп" />
                        <Button fx:id="resetButton" layoutX="161.0" layoutY="132.0" mnemonicParsing="false" onAction="#resetTimer" style="-fx-background-color: #F7C94C; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10px; -fx-border-radius: 5px; -fx-background-radius: 5px;" text="Сброс" />
                        
                        <!-- Основная метка таймера -->
                        <Label fx:id="timerLabel" layoutX="39.0" layoutY="21.0" prefHeight="58.0" prefWidth="100.0" text="00:00" textFill="#7b848f">
                            <font>
                                <Font size="40.0" />
                            </font>
                        </Label>
                        
                        <!-- Метки ожидания таймеров -->
                        <Label fx:id="timerLabel1" layoutX="187.0" layoutY="21.0" prefHeight="58.0" prefWidth="100.0" text="00:00" textFill="#7b848f">
                            <font>
                                <Font size="40.0" />
                            </font>
                        </Label>
                        <Label fx:id="timerLabel2" layoutX="337.0" layoutY="21.0" prefHeight="58.0" prefWidth="100.0" text="00:00" textFill="#7b848f">
                            <font>
                                <Font size="40.0" />
                            </font>
                        </Label>
                        
                        <!-- Указатели очереди ожидания -->
                        <Label layoutX="144.0" layoutY="21.0" prefHeight="0.0" prefWidth="43.0" text="←" textFill="#7b848f">
                            <font>
                                <Font size="40.0" />
                            </font>
                        </Label>
                        <Label layoutX="294.0" layoutY="21.0" prefHeight="0.0" prefWidth="43.0" text="←" textFill="#7b848f">
                            <font>
                                <Font size="40.0" />
                            </font>
                        </Label>
                        
                        <!-- Метка уведомлений -->
                        <Label fx:id="notificationLabel" layoutX="37.0" layoutY="186.0" prefHeight="34.0" prefWidth="400.0" text="" textFill="red" />
